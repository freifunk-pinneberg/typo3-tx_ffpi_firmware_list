{
  "name": "ffpi/firmware-list",
  "type": "typo3-cms-extension",
  "description": "Freifunk Firmware List",
  "license": "GPL-3.0-only",
  "authors": [
    {
      "name": "Kevin Quiatkowski",
      "role": "Developer"
    }
  ],
  "require": {
    "php": ">=8.2",
    "typo3/cms-core": "^12.4 || ^13.4",
    "typo3/cms-extbase": "^12.4 || ^13.4",
    "typo3/cms-fluid": "^12.4 || ^13.4",
    "typo3/cms-frontend": "^12.4 || ^13.4"
  },
  "autoload": {
    "psr-4": {
      "FFPI\\FfpiFirmwareList\\": "Classes"
    }
  },
  "replace": {
    "typo3-ter/ffpi-firmware-list": "self.version"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "ffpi_firmware_list"
    }
  }
}
